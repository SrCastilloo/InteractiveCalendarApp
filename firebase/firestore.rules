rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsProfile(userId);
      allow delete: if false;

      match /tokens/{tokenId} {
        allow read, create, update, delete: if ownsProfile(userId);
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;
      allow update, delete: if signedIn()
        && resource.data.creatorUid == request.auth.uid;
    }
  }
}
